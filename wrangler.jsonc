{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ideaforge-ai",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-11-03",
  "workers_dev": true,
  "preview_urls": false,
  "build": { "command": "npm run build" },
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none", "not_found_handling": "none" },
  "vars": {
    "OPENAI_MODEL": "gpt-6-luna",
    "SUPABASE_URL": "https://wogyedpfuxqvsmxkyhlt.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_pkCFoK-m-HY6BkpJXGzlyw_xfHy_s5R",
    "AI_USER_RPM": "6",
    "AI_USER_DAILY": "100",
    "AI_SITE_DAILY": "500"
  },
  "durable_objects": { "bindings": [{ "name": "AI_LIMITS", "class_name": "AILimits" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AILimits"] }],
  "observability": { "enabled": false }
}
